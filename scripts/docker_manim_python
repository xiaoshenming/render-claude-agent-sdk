#!/usr/bin/env python3
"""Expose the existing Manim Docker image as a Python executable."""

import os
import fcntl
import subprocess
import sys
import time
from pathlib import Path

IMAGE = os.environ.get("MANIM_DOCKER_IMAGE", "docker-manim-worker-1:latest")
REPO = Path(__file__).resolve().parents[1]


def main() -> int:
    cwd = Path.cwd().resolve()
    command = [
        "docker",
        "run",
        "--rm",
        "--user",
        f"{os.getuid()}:{os.getgid()}",
        "--env",
        "HOME=/tmp",
        "--entrypoint",
        "python",
        "--volume",
        f"{REPO}:{REPO}",
        "--workdir",
        str(cwd),
    ]
    if not cwd.is_relative_to(REPO):
        command.extend(("--volume", f"{cwd}:{cwd}"))
    for target in _argument_mounts(sys.argv[1:]):
        command.extend(("--volume", f"{target}:{target}"))
    for name in ("PYTHONPATH", "MATHPI_RENDER_ASSETS_DIR"):
        value = os.environ.get(name)
        if not value:
            continue
        command.extend(("--env", f"{name}={value}"))
        for path in value.split(os.pathsep):
            target = Path(path).resolve()
            if target.is_relative_to(REPO):
                continue
            command.extend(("--volume", f"{target}:{target}:ro"))
    # Sidecar probe wiring: the delegate (frozen runner) is read-only; the
    # sidecar file is written next to the probe output inside cwd, which is
    # already mounted read-write above.
    delegate = os.environ.get("MANIM_LAYOUT_PROBE_DELEGATE")
    if delegate:
        command.extend(("--env", f"MANIM_LAYOUT_PROBE_DELEGATE={delegate}"))
        target = Path(delegate).resolve()
        if not target.is_relative_to(REPO) and not target.is_relative_to(cwd):
            command.extend(("--volume", f"{target}:{target}:ro"))
    sidecar = os.environ.get("MANIM_LAYOUT_PROBE_SIDECAR_PATH")
    if sidecar:
        command.extend(("--env", f"MANIM_LAYOUT_PROBE_SIDECAR_PATH={sidecar}"))
    command.extend((IMAGE, *sys.argv[1:]))
    lock = _acquire_render_slot()
    try:
        return subprocess.run(command, check=False).returncode
    finally:
        if lock is not None:
            fcntl.flock(lock, fcntl.LOCK_UN)
            lock.close()


def _acquire_render_slot():
    limit = int(os.environ.get("MANIM_RENDER_CONCURRENCY", "0") or 0)
    if limit <= 0:
        return None
    root = Path(
        os.environ.get("MANIM_RENDER_SEMAPHORE_DIR", "/tmp/manim-quality-render-slots")
    )
    root.mkdir(parents=True, exist_ok=True)
    while True:
        for index in range(limit):
            handle = (root / f"slot-{index}.lock").open("a+")
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return handle
            except BlockingIOError:
                handle.close()
        time.sleep(0.1)


def _argument_mounts(arguments: list[str]) -> tuple[Path, ...]:
    mounts: set[Path] = set()
    for raw in arguments:
        target = Path(raw)
        if not target.is_absolute() or target.is_relative_to(REPO):
            continue
        while not target.exists():
            target = target.parent
        mounts.add(target if target.is_dir() else target.parent)
    return tuple(
        sorted(
            (
                target
                for target in mounts
                if not any(
                    target != other and target.is_relative_to(other)
                    for other in mounts
                )
            ),
            key=str,
        )
    )


if __name__ == "__main__":
    raise SystemExit(main())
